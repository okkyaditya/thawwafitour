# Required Payload CMS secret. Generate a long random value for each environment.
PAYLOAD_SECRET=

# SQLite database connection. Local default is suitable for development only.
DATABASE_URI=file:./thawwafi.db

# Optional public site URL used for metadata and sitemap.
NEXT_PUBLIC_SITE_URL=https://thawwafi.com
BASE_URL=https://thawwafi.com

# Optional Payload server URL.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional: set to production on deployment.
NODE_ENV=production

# Never commit .env, .env.local, or database files.